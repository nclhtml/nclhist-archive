AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=asia-east2
DEFAULT_FROM=noreply@example.com
firebaseextensions.v1beta.function/location=asia-east2
MAIL_COLLECTION=mail
OAUTH_PORT=465
OAUTH_SECURE=true
SMTP_CONNECTION_URI=smtps://dummy@example.com@smtp.example.com:465
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1